                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"userId\": \"user_12345\",\n  \"properties\": {\n    \"url\": \"https://app.example.com/dashboard\",\n    \"path\": \"/dashboard\",\n    \"title\": \"Dashboard\"\n  }\n}",
                  "options": {
